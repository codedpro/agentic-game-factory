config_version=5

[application]

config/name="MergeDrop"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

I18n="*res://scripts/i18n.gd"
Missions="*res://scripts/missions.gd"
Store="*res://scripts/store.gd"
UI="*res://scripts/ui_kit.gd"
Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"
Fal="*res://scripts/fal.gd"
Share="*res://scripts/share.gd"
IAP="*res://scripts/iap.gd"
Economy="*res://scripts/economy.gd"
Online="*res://scripts/online.gd"
Char="*res://scripts/character.gd"
Notify="*res://scripts/notify.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/poolakey/plugin.cfg", "res://addons/NotificationSchedulerPlugin/plugin.cfg", "res://addons/myket/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.11, 0.125, 0.18, 1)
